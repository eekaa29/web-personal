{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "build": {
    "env": {
      "VERCEL": "1"
    }
  },
  "buildCommand": "bash build.sh",
  "functions": {
    "api/index.py": {
      "runtime": "python3.12"
    }
  },
  "rewrites": [
    { "source": "/static/(.*)", "destination": "/public/static/$1" },
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
